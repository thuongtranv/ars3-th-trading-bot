# ARS-3 Trading Bot Environment Variables
# Copy this file to .env and fill in your actual values

# REQUIRED: Telegram Bot Configuration
# Get these from BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# REQUIRED FOR LIVE TRADING: Exchange API Keys
# Get these from your exchange account settings
# WARNING: Keep these secret and secure!
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here

# OPTIONAL: Email Notifications  
# Use app-specific passwords for Gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_TO=recipient@gmail.com

# OPTIONAL: Additional Exchange Support
# Uncomment and fill if using other exchanges
# BYBIT_API_KEY=your_bybit_key
# BYBIT_SECRET=your_bybit_secret
# COINBASE_API_KEY=your_coinbase_key
# COINBASE_SECRET=your_coinbase_secret

# SECURITY NOTE:
# Never commit .env files to version control
# Keep your API keys private and secure
# Use testnet for initial testing